{
  "name": "@silverfox0338/aurora",
  "version": "3.0.0",
  "description": "Aurora: deterministic audio analysis and rhythm-game chart generation from decoded PCM.",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "rhythm-game",
    "chart-generator",
    "beatmap",
    "music-analysis",
    "audio-analysis",
    "beat-tracking",
    "bpm-detection",
    "tempo-detection",
    "onset-detection",
    "music-information-retrieval",
    "dsp",
    "game-development",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silverfox0338/aurora.git"
  },
  "homepage": "https://github.com/Silverfox0338/aurora#readme",
  "bugs": {
    "url": "https://github.com/Silverfox0338/aurora/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
